# Application
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
API_PUBLIC_URL=http://localhost:4000
WEB_APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Optional on loopback development; required (32+ characters) in production.
OPERATOR_API_TOKEN=

# Control-plane PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/prompt2api?sslmode=disable

# Dataset PostgreSQL used by the Substreams sink
DATASET_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/prompt2api_datasets?sslmode=disable

# Gemini pipeline planner
LLM_PROVIDER=google
LLM_MODEL=gemini-3-flash-preview
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
LLM_TIMEOUT_MS=30000
PLANNER_PROMPT_VERSION=v1

# The Graph / Substreams
SUBSTREAMS_ENDPOINT=base-mainnet.streamingfast.io:443
SUBSTREAMS_API_TOKEN=YOUR_SUBSTREAMS_JWT_TOKEN
SUBSTREAMS_CLI_PATH=substreams
SUBSTREAMS_TEMPLATE_VERSION=v1
ETHEREUM_COMMON_PACKAGE=ethereum-common@v0.3.3

# Generated artifacts
ARTIFACT_ROOT=./generated

# Execution limits
BUILD_TIMEOUT_SECONDS=600
VALIDATION_TIMEOUT_SECONDS=180
VALIDATION_BLOCK_COUNT=100
MAX_ACTIVE_PIPELINE_JOBS=1

# x402 paid dataset routes (native HBAR; amount is in tinybars)
X402_ENABLED=false
X402_NETWORK=hedera:testnet
X402_SCHEME=exact
X402_ASSET=0.0.0
X402_PRICE=100000
X402_PAY_TO=0.0.123456
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_MAX_TIMEOUT_SECONDS=300
X402_FACILITATOR_TIMEOUT_MS=30000

# Frontend demo-payer safeguards. Copy these to apps/web/.env.local when
# enabling the button outside localhost development.
DEMO_PURCHASE_ENABLED=false
DEMO_PURCHASE_COOLDOWN_MS=10000
DEMO_PURCHASE_MAX_PER_PROCESS=25
DEMO_PURCHASE_TIMEOUT_MS=60000
