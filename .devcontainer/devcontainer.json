{
  "name": "IndexLoom Substreams",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "SUBSTREAMS_VERSION": "1.22.0",
      "BUF_VERSION": "1.72.0"
    }
  },
  "workspaceFolder": "/workspace/IndexLoom",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/IndexLoom,type=bind,consistency=cached",
  "mounts": [
    "source=indexloom-root-node-modules,target=/workspace/IndexLoom/node_modules,type=volume",
    "source=indexloom-api-node-modules,target=/workspace/IndexLoom/apps/api/node_modules,type=volume",
    "source=indexloom-web-node-modules,target=/workspace/IndexLoom/apps/web/node_modules,type=volume",
    "source=indexloom-contracts-node-modules,target=/workspace/IndexLoom/packages/contracts/node_modules,type=volume",
    "source=indexloom-dataset-service-node-modules,target=/workspace/IndexLoom/packages/dataset-service/node_modules,type=volume",
    "source=indexloom-db-node-modules,target=/workspace/IndexLoom/packages/db/node_modules,type=volume",
    "source=indexloom-generator-node-modules,target=/workspace/IndexLoom/packages/generator/node_modules,type=volume",
    "source=indexloom-pipeline-config-node-modules,target=/workspace/IndexLoom/packages/pipeline-config/node_modules,type=volume",
    "source=indexloom-planner-node-modules,target=/workspace/IndexLoom/packages/planner/node_modules,type=volume",
    "source=indexloom-substreams-runner-node-modules,target=/workspace/IndexLoom/packages/substreams-runner/node_modules,type=volume"
  ],
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "pnpmVersion": "10"
    }
  },
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],
  "forwardPorts": [
    3000,
    4000
  ],
  "portsAttributes": {
    "3000": {
      "label": "IndexLoom web"
    },
    "4000": {
      "label": "IndexLoom API"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "bufbuild.vscode-buf",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "Prisma.prisma"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
