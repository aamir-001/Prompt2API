{
  "name": "Prompt2API Substreams",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "SUBSTREAMS_VERSION": "1.22.0",
      "BUF_VERSION": "1.72.0"
    }
  },
  "workspaceFolder": "/workspace/Prompt2API",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/Prompt2API,type=bind,consistency=cached",
  "mounts": [
    "source=prompt2api-root-node-modules,target=/workspace/Prompt2API/node_modules,type=volume",
    "source=prompt2api-api-node-modules,target=/workspace/Prompt2API/apps/api/node_modules,type=volume",
    "source=prompt2api-consumer-agent-node-modules,target=/workspace/Prompt2API/apps/consumer-agent/node_modules,type=volume",
    "source=prompt2api-web-node-modules,target=/workspace/Prompt2API/apps/web/node_modules,type=volume",
    "source=prompt2api-contracts-node-modules,target=/workspace/Prompt2API/packages/contracts/node_modules,type=volume",
    "source=prompt2api-dataset-service-node-modules,target=/workspace/Prompt2API/packages/dataset-service/node_modules,type=volume",
    "source=prompt2api-db-node-modules,target=/workspace/Prompt2API/packages/db/node_modules,type=volume",
    "source=prompt2api-generator-node-modules,target=/workspace/Prompt2API/packages/generator/node_modules,type=volume",
    "source=prompt2api-pipeline-config-node-modules,target=/workspace/Prompt2API/packages/pipeline-config/node_modules,type=volume",
    "source=prompt2api-planner-node-modules,target=/workspace/Prompt2API/packages/planner/node_modules,type=volume",
    "source=prompt2api-substreams-runner-node-modules,target=/workspace/Prompt2API/packages/substreams-runner/node_modules,type=volume"
  ],
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "pnpmVersion": "10"
    }
  },
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],
  "forwardPorts": [
    3000,
    4000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Prompt2API web"
    },
    "4000": {
      "label": "Prompt2API API"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "bufbuild.vscode-buf",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "Prisma.prisma"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
