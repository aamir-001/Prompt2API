{
  "name": "@indexloom/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
