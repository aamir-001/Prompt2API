{
  "name": "prompt2api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @prompt2api/api dev",
    "dev:web": "pnpm --filter @prompt2api/web dev",
    "dev:agent": "pnpm --filter @prompt2api/consumer-agent dev",
    "db:generate": "pnpm --filter @prompt2api/db prisma:generate",
    "db:migrate": "pnpm --filter @prompt2api/db prisma:migrate",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:database": "node scripts/test-database.js",
    "test:live:gemini": "node scripts/test-live.js gemini",
    "test:live:substreams": "node scripts/test-live.js substreams",
    "generate:golden": "tsx scripts/generate-golden.ts",
    "warm:substreams": "tsx scripts/warm-substreams.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "6.4.3",
    "vitest": "3.2.4"
  }
}
