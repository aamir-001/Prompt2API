# Localhost development needs no operator login. Production requires both this
# opt-in and OPERATOR_API_TOKEN authentication.
DEMO_PURCHASE_ENABLED=false
DEMO_PURCHASE_COOLDOWN_MS=10000
DEMO_PURCHASE_MAX_PER_PROCESS=25
DEMO_PURCHASE_TIMEOUT_MS=60000

# Use the same operator token configured for the Prompt2API API.
OPERATOR_API_TOKEN=
